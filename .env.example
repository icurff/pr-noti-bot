# ========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO REPORELAY (PR NOTIFICATION BOT)
# Copy file này thành file .env:  cp .env.example .env
# ========================================================

# 1. Discord Bot Configuration (BẮT BUỘC)
# Lấy từ: Discord Developer Portal > Applications > Bot > Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ID kênh text Discord nhận thông báo PR (dãy số ID)
DISCORD_CHANNEL_PRS=1545271341438079077

# Kênh riêng biệt tùy chọn (để trống sẽ dùng chung kênh DISCORD_CHANNEL_PRS)
DISCORD_CHANNEL_ISSUES=
DISCORD_CHANNEL_RELEASES=
DISCORD_CHANNEL_DEPLOYMENTS=
DISCORD_CHANNEL_SECURITY=

# 2. GitHub Webhook Configuration
# Chuỗi bí mật tự tạo để bảo mật webhook (trùng với Secret điền trên GitHub Settings)
GITHUB_WEBHOOK_SECRET=your_super_secret_webhook_key_here

# Tên Repository (Tùy chọn)
GITHUB_REPOSITORY=my-org/my-project

# GitHub Personal Access Token (Tùy chọn - dùng để tra cứu chi tiết bước CI thất bại)
GITHUB_TOKEN=

# 3. Server Configuration (Mặc định trong Docker không cần sửa)
PORT=3000
HOST=0.0.0.0
WEBHOOK_PATH=/webhook
STATE_DIR=/app/state
