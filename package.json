{
  "name": "repo-relay",
  "version": "1.0.0",
  "description": "Self-hosted GitHub-Discord webhook integration bot for development notifications",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["github", "discord", "webhook", "notifications", "bot"],
  "author": "Christopher Pishaki <ChrisPishaki@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "discord.js": "^14.16.3",
    "express": "^5.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.12.0",
    "eslint": "^9.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.0"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
